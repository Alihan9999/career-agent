#!/usr/bin/env bash
# Pre-commit hook: blocks secrets and sensitive files.
# Bypass with `git commit --no-verify` if you're absolutely sure.

set -e
HOOK_DIR="$(dirname "$0")"

# Prefer py launcher on Windows; fall back to python3 / python.
if command -v py >/dev/null 2>&1; then
    py -3 "$HOOK_DIR/scan-secrets.py"
elif command -v python3 >/dev/null 2>&1; then
    python3 "$HOOK_DIR/scan-secrets.py"
elif command -v python >/dev/null 2>&1; then
    python "$HOOK_DIR/scan-secrets.py"
else
    echo "pre-commit: no Python interpreter found — skipping secret scan." >&2
    exit 0
fi
