# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Scrapling dev-mode cache (created by Fetcher with development=True)
.scrapling-cache/
.scrapling/

# Your personal data (real resume content, contact info — never commit)
data/*.md
!data/*.example.md

# Generated application output (contains personal resume/cover letter data)
output/*/
!output/.gitkeep

# Claude Code local settings (machine-specific permissions — keep private)
.claude/settings.json
.claude/settings.local.json
# .claude/commands/ is intentionally tracked so collaborators get the slash commands

# Google Form config (contains your real form URL and entry IDs — never commit)
config/google-form.md
!config/google-form.example.md

# Target companies watchlist (reveals job search strategy — keep private)
config/target-companies.yml
!config/target-companies.example.yml

# Environment variables (Google Form IDs, any future API keys)
.env
.env.local

# Gap analysis reports (reveals job search targets — keep private)
analysis/

# Scan results (reveals job search targets and company watchlist — keep private)
scans/*/
!scans/.gitkeep

# Project schematics (reveals skill gaps and job search strategy — keep private)
projects/

# URL input lists for /bulk-apply (reveals job search strategy — keep private)
inputs/*
!inputs/.gitkeep
!inputs/README.md

# PDF artifacts
*.pdf

# OS junk
.DS_Store
Thumbs.db
